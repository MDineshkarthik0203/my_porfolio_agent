# AI Digital Twin Portfolio - Environment Configuration

# Backend LLM Configuration
LLM_PROVIDER=groq # groq | openai | local
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Fallback / Alternative
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-digital-twin-portfolio

# GitHub Integration (Optional for higher rate limits)
GITHUB_ACCESS_TOKEN=your_github_token_here
GITHUB_USERNAME=MDineshkarthik0203

# Database & Vector Store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_twin
VECTOR_STORE_TYPE=in_memory # in_memory | pgvector | qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
